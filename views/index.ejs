<!-- views/index.ejs -->
<!-- FINAL UPDATED WITH PROPER LOGOUT BUTTON -->

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>CEMS Dashboard</title>

<link rel="stylesheet" href="/style.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>

<div class="layout">

<!-- SIDEBAR -->
<aside class="sidebar">

<div class="logo">CEMS</div>

<!-- MENU -->
<a href="/" class="active">📊 Dashboard</a>
<a href="/search">🔍 Search Elector</a>
<a href="/migration">🔁 Migration Request</a>

<button onclick="toggleTheme()" class="themebtn">
🌙 Toggle Theme
</button>

<a href="/export-csv" class="csvbtn">
⬇ Export Records (.CSV)
</a>

<!-- LOGOUT -->
<a href="/logout" class="logoutbtn">
🚪 Logout
</a>

</aside>

<!-- MAIN -->
<main class="main">

<div class="topbar">
<h1>Central Electoral Dashboard</h1>
<p>Unified Citizen Electoral Management System - 5000+ Records</p>
</div>

<% if(msg){ %>
<div class="success"><%= msg %></div>
<% } %>

<!-- CARDS -->
<section class="cards">

<div class="card">
<h3>Total Electors</h3>
<span><%= total %></span>
</div>

<div class="card">
<h3>Migrations Completed</h3>
<span><%= done %></span>
</div>

<div class="card">
<h3>Polling Stations</h3>
<span>5971</span>
</div>

</section>

<!-- GRAPH -->
<section class="charts">

<div class="chartbox fullgraph">
<h3>State-wise Elector Distribution (5000)</h3>
<canvas id="barChart"></canvas>
</div>

</section>

<!-- SEARCH -->
<form action="/search" method="GET" class="searchbar">
<input type="text" name="q" placeholder="Search by Name or State">
<button type="submit">Search</button>
</form>

<!-- TABLE -->
<section class="tablebox">

<table>

<tr>
<th>ID</th>
<th>Name</th>
<th>Age</th>
<th>State</th>
<th>Status</th>
</tr>

<% voters.forEach(v=>{ %>
<tr>
<td><%= v.id %></td>
<td><%= v.name %></td>
<td><%= v.age %></td>
<td><%= v.state %></td>
<td><span class="pill"><%= v.status %></span></td>
</tr>
<% }) %>

</table>

<p style="margin-top:14px;color:#64748b;font-weight:600;">
Showing first 100 records out of <%= total %>
</p>

</section>

</main>
</div>

<script>

/* THEME */
function toggleTheme(){
 document.body.classList.toggle("dark");

 localStorage.setItem(
   "theme",
   document.body.classList.contains("dark") ? "dark" : "light"
 );
}

window.onload=function(){
 if(localStorage.getItem("theme")==="dark"){
   document.body.classList.add("dark");
 }
}

/* GRAPH */
new Chart(document.getElementById("barChart"),{
type:"bar",
data:{
labels:["Delhi","Punjab","UP","Maharashtra","Gujarat"],
datasets:[{
label:"Electors",
data:[1000,1000,1000,1000,1000],
borderWidth:1
}]
},
options:{
responsive:true,
plugins:{legend:{display:false}},
scales:{y:{beginAtZero:true}}
}
});

</script>

</body>
</html>